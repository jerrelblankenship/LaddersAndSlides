{
  "name": "ladders-and-slides",
  "version": "2.0.0",
  "description": "Modern TypeScript/Bun implementation of the classic Chutes and Ladders board game",
  "main": "dist/index.js",
  "packageManager": "bun@1.0.0",
  "scripts": {
    "build": "tsc && bun run copy-assets",
    "copy-assets": "mkdir -p dist/assets && cp -r src/assets/* dist/assets/",
    "dev": "bun run build && bun run start",
    "start": "bun run dist/server.ts",
    "test": "bun test",
    "watch": "tsc --watch"
  },
  "keywords": [
    "game",
    "board-game",
    "chutes-and-ladders",
    "typescript",
    "bun"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "express": "^4.18.2",
    "@types/express": "^4.17.21"
  }
}
